# Template of the GitHub Environment secret STAGING_APP_ENV (rendered on the host as app.env by deploy-staging.yml).
# Every variable is described in .env.example; the API refuses to boot on anything env.schema.ts rejects. Staging runs
# NODE_ENV=production on purpose: the same TLS and placeholder-credential rules as production apply.
# Fill the empty values in the secret only — never commit real ones.
NODE_ENV=production
LOG_LEVEL=info
# Caddy is the one proxy in front of the API (infra/staging/Caddyfile).
TRUST_PROXY_HOPS=1
# The office app on Cloudflare Pages (and its preview domain if previews must call staging).
CORS_ORIGINS=https://staging.app.example.com
OFFICE_APP_URL=https://staging.app.example.com
# Swagger at /api/docs is handy on staging; the IP allow-list keeps it private.
SWAGGER_ENABLED=true

# Managed services, TLS required (env.schema.ts production rules).
# Postgres as the application role nexlegtiq_app (never the migrator), with ?sslmode=verify-full (or require).
DATABASE_URL=
# rediss:// URL of the managed Redis.
REDIS_URL=
BULLMQ_PREFIX=nlq-staging
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=nexlegtiq-documents-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 on AWS S3, none on R2/Spaces (they encrypt at rest).
S3_SSE=none

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@staging.example.com
EMAIL_PROVIDER=smtp

# The ClamAV sidecar in infra/staging/compose.yml.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# openssl rand -base64 48 (a different value per environment)
JWT_SECRET=
# Platform admin realm (D-145): its own secret (not JWT_SECRET; unset = admin routes answer 404), the admin panel's
# origin (also in CORS_ORIGINS) and, ideally, the addresses allowed to reach it.
ADMIN_JWT_SECRET=
ADMIN_ORIGINS=
ADMIN_IP_ALLOWLIST=
EMAIL_VERIFICATION_ENFORCED=false
BULL_BOARD_ENABLED=false

# AI (D-130, D-131): text is PII-redacted before any provider call. To switch AI on, e.g.
# AI_PRIMARY_PROVIDER=openai with OPENAI_API_KEY/OPENAI_MODEL, AI_FALLBACK_PROVIDER=gemini with GEMINI_API_KEY/GEMINI_MODEL.
AI_PRIMARY_PROVIDER=none
AI_FALLBACK_PROVIDER=none
