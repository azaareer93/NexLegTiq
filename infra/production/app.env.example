# Template of the GitHub Environment secret PROD_APP_ENV (rendered on the host as app.env by release.yml, D-225).
# Every variable is described in .env.example; the API refuses to boot on anything env.schema.ts rejects.
# Fill the empty values in the secret only — never commit real ones. Every secret differs from staging's.
NODE_ENV=production
LOG_LEVEL=info
# Caddy is the one proxy in front of the API (infra/production/Caddyfile).
TRUST_PROXY_HOPS=1
# The three SPAs on the CDN (the admin panel is also in ADMIN_ORIGINS).
CORS_ORIGINS=https://app.example.com,https://portal.example.com,https://admin.example.com
OFFICE_APP_URL=https://app.example.com
CLIENT_PORTAL_URL=https://portal.example.com
SWAGGER_ENABLED=false

# Managed services, TLS required (env.schema.ts production rules).
# Postgres as the application role nexlegtiq_app (never the migrator), with ?sslmode=verify-full (or require).
DATABASE_URL=
# rediss:// URL of the managed Redis.
REDIS_URL=
BULLMQ_PREFIX=nlq
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=nexlegtiq-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 on AWS S3, none on R2/Spaces (they encrypt at rest).
S3_SSE=none

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
EMAIL_PROVIDER=smtp

# The ClamAV sidecar in infra/production/compose.yml.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# openssl rand -base64 48 — one different value each (and different from staging's).
JWT_SECRET=
JWT_PORTAL_SECRET=
ADMIN_JWT_SECRET=
ADMIN_ORIGINS=https://admin.example.com
# The same ranges as ADMIN_ALLOWED_IPS (the Caddy edge check): the office, your home.
ADMIN_IP_ALLOWLIST=
# openssl rand -hex 32. Losing it makes the encrypted fields unreadable: keep a copy offline (D-108).
ENCRYPTION_KEY=
EMAIL_VERIFICATION_ENFORCED=false
BULL_BOARD_ENABLED=false

# AI (D-130, D-131): text is PII-redacted before any provider call. To switch AI on, e.g.
# AI_PRIMARY_PROVIDER=openai with OPENAI_API_KEY/OPENAI_MODEL, AI_FALLBACK_PROVIDER=gemini with GEMINI_API_KEY/GEMINI_MODEL.
AI_PRIMARY_PROVIDER=none
AI_FALLBACK_PROVIDER=none
