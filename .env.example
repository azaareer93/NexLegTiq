# NexLegTiq backend-api environment (validated at boot: apps/backend-api/src/config/env.schema.ts)
# Copy to .env for local development. Never commit real secrets.

# Unset behaves like production (fail closed). Set development locally.
NODE_ENV=development
# Bind address/port of the HTTP API. Containers set HOST=0.0.0.0.
HOST=localhost
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development only
LOG_PRETTY=true

# Comma-separated SPA origins allowed by CORS (office-app, admin-panel, client-portal)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Swagger UI at /api/docs; defaults to on outside production
SWAGGER_ENABLED=true

# Prometheus /metrics on a separate internal port. In containers set METRICS_HOST=0.0.0.0 and never publish the port;
# only the internal network (Prometheus/agent) may reach it.
METRICS_ENABLED=true
METRICS_HOST=localhost
METRICS_PORT=9464

# Reverse proxies in front of the API (Caddy/Traefik) whose X-Forwarded-For is trusted for client IPs. 0 locally.
TRUST_PROXY_HOPS=0
