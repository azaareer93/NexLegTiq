# NexLegTiq backend-api environment (validated at boot: apps/backend-api/src/config/env.schema.ts)
# Copy to .env for local development. Never commit real secrets.

# Unset behaves like production (fail closed). Set development locally.
NODE_ENV=development
# Bind address/port of the HTTP API. Containers set HOST=0.0.0.0.
HOST=localhost
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development only
LOG_PRETTY=true

# Comma-separated SPA origins allowed by CORS (office-app, admin-panel, client-portal)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Swagger UI at /api/docs; defaults to on outside production
SWAGGER_ENABLED=true

# Prometheus /metrics on a separate internal port. In containers set METRICS_HOST=0.0.0.0 and never publish the port;
# only the internal network (Prometheus/agent) may reach it.
METRICS_ENABLED=true
METRICS_HOST=localhost
METRICS_PORT=9464

# Reverse proxies in front of the API (Caddy/Traefik) whose X-Forwarded-For is trusted for client IPs. 0 locally.
TRUST_PROXY_HOPS=0

# Backing services — required, no defaults (the API refuses to boot without them). Values match docker/compose.dev.yml.
DATABASE_URL=postgresql://nexlegtiq:nexlegtiq@localhost:5432/nexlegtiq
REDIS_URL=redis://localhost:6379
# Prefix for every BullMQ key (lowercase, digits, dashes)
BULLMQ_PREFIX=nlq

# S3-compatible object storage (RustFS locally; R2/S3/Spaces elsewhere). Path-style is required locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexlegtiq-documents-local
S3_ACCESS_KEY_ID=nexlegtiq
S3_SECRET_ACCESS_KEY=nexlegtiq-dev-only
S3_FORCE_PATH_STYLE=true

# Outgoing mail (Mailpit locally: UI at http://localhost:8025). SMTP_USER/SMTP_PASSWORD: set both or neither.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit offers no STARTTLS; production defaults this to true
SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=no-reply@nexlegtiq.test

# ClamAV daemon (clamd) used to scan uploads before they become READY
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
