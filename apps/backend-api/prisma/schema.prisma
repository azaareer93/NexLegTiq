// NexLegTiq database schema. Canonical model: docs/context/domain-model.md; conventions: .claude/rules/prisma.md.
// Tenant tables carry a non-null office_id and are listed in src/database/tenant-models.ts (MVP-37 enforces it).
// Plan approved on MVP-33 (Jira comment 10044); choices recorded in D-079.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─── Enums (UPPER_SNAKE, D-016; labels come from i18n) ──────────────────────────────────────────────────────────

enum Jurisdiction {
  PALESTINE
  JORDAN
  EGYPT
  SAUDI_ARABIA
  UAE
  KUWAIT
  QATAR
  OMAN
  BAHRAIN
  LEBANON
  IRAQ
  MOROCCO
  USA
  UK
  OTHER
}

enum OfficeLanguage {
  AR
  EN
  BILINGUAL
}

/// Chosen at signup (onboarding step 1); picks the global trial plan (D-083).
enum AccountType {
  SOLO
  FIRM
  CORPORATE
}

enum DigitStyle {
  WESTERN
  ARABIC_INDIC
}

enum UiLanguage {
  AR
  EN
}

enum Role {
  OFFICE_MANAGER
  SENIOR_LAWYER
  LAWYER
  PARALEGAL
  ADMIN
  TRAINEE
  EXTERNAL_COLLABORATOR
}

enum BillingMethod {
  HOURLY
  FIXED_FEE
  RETAINER
  CONTINGENCY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LegalDocumentType {
  TOS
  PRIVACY
  DPA
}

enum PlanMarket {
  PALESTINE
  GLOBAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  NONE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  DOWNLOAD
  SHARE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_DENIED
  SECURITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum ClientType {
  INDIVIDUAL
  CORPORATION
  GOVERNMENT
  NGO
  PARTNERSHIP
}

/// Number type codes (LIT, CRM, …) live in src/modules/legal-files/file-number.ts (D-031, D-034).
