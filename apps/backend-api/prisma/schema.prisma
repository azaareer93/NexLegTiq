}

/// The default folders every file gets when it is inserted (trigger of migration add_documents, D-119). Their names are
/// labels, never stored.
enum FolderSystemKey {
  PLEADINGS
  EVIDENCE
  COURT_ORDERS
  CONTRACTS
  CORRESPONDENCE
  CLIENT_UPLOADS
}

/// What an AI job or output is about (D-039 AiSummarySourceType; D-130).
enum AiSourceType {
  DOCUMENT
  SESSION
  WITNESS_STATEMENT
  COURT_RULING
  OPPOSING_BRIEF
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// ─── Tenancy & identity ─────────────────────────────────────────────────────────────────────────────────────────

/// The tenant. Every tenant-owned row references it.
model Office {
  id                 String         @id @default(uuid(7)) @db.Uuid
  name               String
  registrationNumber String?        @map("registration_number")
  taxId              String?        @map("tax_id")
  phone              String?
  email              String?        @db.Citext
  address            String?
  website            String?
  jurisdiction       Jurisdiction   @default(PALESTINE)
  accountType        AccountType    @default(SOLO) @map("account_type")
  defaultLanguage    OfficeLanguage @default(AR) @map("default_language")
  /// ISO-4217 code (D-004): ILS, JOD, USD are common in Palestine.
  currency           String         @default("ILS") @db.Char(3)
  timezone           String         @default("Asia/Hebron")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings            OfficeSettings?
  users               User[]
  invitations         OfficeInvitation[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  legalAcceptances    LegalAcceptance[]
  subscriptions       Subscription[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  aiJobs              AiJob[]
  aiUsages            AiUsage[]
  clients             Client[]
  contactPersons      ContactPerson[]
  legalFiles          LegalFile[]
  fileClients         FileClient[]
  fileTeamMembers     FileTeamMember[]
  fileNumberSequences FileNumberSequence[]
  parties             Party[]
  fileParties         FileParty[]
  conflicts           ConflictOfInterest[]
  timelineEvents      CaseTimelineEvent[]
  fileNotes           FileNote[]
  taskTemplates       TaskTemplate[]
  tasks               Task[]
  courts              Court[]
  judges              Judge[]
  publicProsecutors   PublicProsecutor[]
  sessions            Session[]
  sessionReminders    SessionReminder[]
  sessionAttendances  SessionPartyAttendance[]
  documentFolders     DocumentFolder[]
  documents           Document[]
  documentVersions    DocumentVersion[]
  documentTexts       DocumentText[]

  @@map("offices")
}

/// Typed per-office settings (not key/value). audit_retention_days >= 365 is a CHECK constraint (D-060).
model OfficeSettings {
  id                    String        @id @default(uuid(7)) @db.Uuid
  officeId              String        @unique @map("office_id") @db.Uuid
  courtReminderDays     Int[]         @default([7, 3, 1]) @map("court_reminder_days")
  taskReminderDays      Int[]         @default([1]) @map("task_reminder_days")
  defaultBillingRate    Decimal?      @map("default_billing_rate") @db.Decimal(14, 2)
  defaultBillingMethod  BillingMethod @default(HOURLY) @map("default_billing_method")
  taxRatePercent        Decimal       @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  enableAi              Boolean       @default(true) @map("enable_ai")
  enableOcr             Boolean       @default(true) @map("enable_ocr")
  /// Google Vision for hard-to-read scans (D-142): the office's opt-in, also gated by the plan flag `googleVisionOcr`.
  enableVisionOcr       Boolean       @default(false) @map("enable_vision_ocr")
  fileNumberFormat      String        @default("{YEAR}-{TYPE}-{SEQ:5}") @map("file_number_format")
  sessionIdleMinutes    Int           @default(30) @map("session_idle_minutes")
  auditRetentionDays    Int           @default(365) @map("audit_retention_days")
  /// Highest retention ever set; kept by a trigger (never lowered) and used by the purge (D-136).
  maxAuditRetentionDays Int           @default(365) @map("max_audit_retention_days")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@map("office_settings")
}

/// One login = one office (D-032): email is unique across all offices.
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  officeId          String     @map("office_id") @db.Uuid
  fullName          String     @map("full_name")
  email             String     @unique @db.Citext
  passwordHash      String     @map("password_hash")
  role              Role
  phone             String?
  avatarUrl         String?    @map("avatar_url")
  isActive          Boolean    @default(true) @map("is_active")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Null until the signup email is confirmed; unverified accounts lose access 7 days after signup (AUTH-010, D-083).
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  uiLanguage        UiLanguage @default(AR) @map("ui_language")
  /// The user's own zone: what is addressed to them (reminder emails, D-117) is written in it; screens show the office's (D-127, D-146).
  timezone          String?
  /// Digits on screen: Western (default) or Arabic-Indic (D-092, D-146).
  digitStyle        DigitStyle @default(WESTERN) @map("digit_style")
  /// Notification channels turned off, per category: {"HEARINGS": {"email": false}} — absent = on (D-146).
  notificationPrefs Json       @default("{}") @map("notification_prefs")
  /// AES-256-GCM ciphertext (D-056), never the raw secret.
  mfaSecret         String?    @map("mfa_secret")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  office              Office                   @relation(fields: [officeId], references: [id])
  sentInvitations     OfficeInvitation[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  legalAcceptances    LegalAcceptance[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  sessionReminders    SessionReminder[]        @relation("SessionReminderRecipient")
  primaryClients      Client[]                 @relation("ClientPrimaryLawyer")
  responsibleFiles    LegalFile[]              @relation("FileResponsibleLawyer")
  paralegalFiles      LegalFile[]              @relation("FileResponsibleParalegal")
  fileTeams           FileTeamMember[]
  resolvedConflicts   ConflictOfInterest[]
  timelineEvents      CaseTimelineEvent[]
  fileNotes           FileNote[]
  assignedTasks       Task[]                   @relation("TaskAssignee")
  createdTasks        Task[]                   @relation("TaskCreator")
  attendedSessions    Session[]                @relation("SessionAttendingLawyer")
  createdSessions     Session[]                @relation("SessionCreator")
  uploadedDocuments   Document[]               @relation("DocumentUploader")
  documentVersions    DocumentVersion[]        @relation("DocumentVersionCreator")

  /// Target of the composite (user_id, office_id) FKs: a child row can never name a user of another office (D-079).
  aiJobs   AiJob[]
  aiUsages AiUsage[]

  @@unique([id, officeId])
  @@index([officeId, role])
  @@map("users")
}

/// Admin-panel operators. Not an office role; MFA is mandatory.
model PlatformAdmin {
  id           String    @id @default(uuid(7)) @db.Uuid
  fullName     String    @map("full_name")
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  /// AES-256-GCM ciphertext (D-056).
  mfaSecret    String    @map("mfa_secret")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs AuditLog[]

  @@map("platform_admins")
}

model OfficeInvitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  officeId    String           @map("office_id") @db.Uuid
  email       String           @db.Citext
  /// Any role except OFFICE_MANAGER (enforced by the service).
  role        Role
  /// SHA-256 of the emailed token; the token itself is never stored.
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById String           @map("invited_by_id") @db.Uuid
  /// The name the manager typed, offered on the accept page (D-134).
  fullName    String?          @map("full_name")
  message     String?
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  office    Office @relation(fields: [officeId], references: [id])
  invitedBy User   @relation(fields: [invitedById, officeId], references: [id, officeId])

  @@index([officeId, status])
  @@index([officeId, email])
  @@map("office_invitations")
}

/// Office users only; admin-panel and portal sessions get their own tables (D-079). Rotated on every refresh;
/// reuse of a revoked token revokes the whole family (auth-rbac.md).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  officeId     String    @map("office_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque cookie value.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  office     Office        @relation(fields: [officeId], references: [id])
  user       User          @relation(fields: [userId, officeId], references: [id, officeId], onDelete: Cascade)
  // Composite like the user FK: a rotation can only point at a token of the same office (D-080 review).
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById, officeId], references: [id, officeId], onDelete: NoAction, onUpdate: NoAction)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@unique([id, officeId])
  @@unique([replacedById, officeId])
  @@index([officeId, userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  officeId  String    @map("office_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])
  user   User   @relation(fields: [userId, officeId], references: [id, officeId], onDelete: Cascade)

  @@index([officeId, userId])
  @@map("password_reset_tokens")
}

/// Global (not tenant-scoped): recorded before login, when the email may match no user (D-053 lockout, D-079).
model LoginAttempt {
  id          String   @id @default(uuid(7)) @db.Uuid
  email       String   @db.Citext
  ipAddress   String   @map("ip_address") @db.Inet
  success     Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(3)

  // Lockout reads one email + IP pair, newest first (D-053); the email prefix also serves per-account queries.
  @@index([email, ipAddress, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

/// Signup email-verification link (D-083): 7 days, single use, stored as SHA-256 only.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  officeId  String    @map("office_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])
  user   User   @relation(fields: [userId, officeId], references: [id, officeId], onDelete: Cascade)

  @@index([officeId, userId])
  @@map("email_verification_tokens")
}

/// ToS / privacy / DPA version a user accepted. Portal users (clientUserId) arrive with the Client Portal.
model LegalAcceptance {
  id           String            @id @default(uuid(7)) @db.Uuid
  officeId     String            @map("office_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  documentType LegalDocumentType @map("document_type")
  version      String
  acceptedAt   DateTime          @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ipAddress    String?           @map("ip_address") @db.Inet

  office Office @relation(fields: [officeId], references: [id])
  user   User   @relation(fields: [userId, officeId], references: [id, officeId])

  @@unique([userId, documentType, version])
  @@index([officeId, userId])
  @@map("legal_acceptances")
}

// ─── Plans & subscriptions (D-005, D-006) ───────────────────────────────────────────────────────────────────────

/// Platform-wide catalogue. Feature gating reads `features`, never plan codes or names.
model Plan {
  id              String     @id @default(uuid(7)) @db.Uuid
  code            String     @unique
  name            String
  market          PlanMarket
  priceMonthly    Decimal    @map("price_monthly") @db.Decimal(14, 2)
  currency        String     @db.Char(3)
  /// null = unlimited.
  maxUsers        Int?       @map("max_users")
  /// null = unlimited.
  aiQuotaMonthly  Int?       @map("ai_quota_monthly")
  /// Google Vision OCR pages per office and month (D-142); 0 = none.
  ocrPagesMonthly Int        @default(0) @map("ocr_pages_monthly")
  storageQuotaMb  Int        @map("storage_quota_mb")
  /// Free/trial length in days for plans that start in TRIALING (e.g. 180 for the Palestine freemium, 30 globally).
  trialDays       Int?       @map("trial_days")
  features        Json       @default("{}")
  isActive        Boolean    @default(true) @map("is_active")
  sortOrder       Int        @default(0) @map("sort_order")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@index([market, isActive])
  @@map("plans")
}

/// At most one TRIALING/ACTIVE subscription per office: partial unique index in the migration (D-079).
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  officeId           String             @map("office_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(3)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  paymentMethod      PaymentMethod      @default(NONE) @map("payment_method")
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([officeId, status])
  @@map("subscriptions")
}

// ─── Clients, legal files & parties (MVP-56, D-095) ─────────────────────────────────────────────────────────────
// References between tenant rows are composite (…_id, office_id) FKs, so no row can point into another office (D-079).
// Composite relations are Restrict on update (ids and office_id never change; a cascade would carry rows into another
// office) and, when optional, on delete (SetNull would also null office_id).

/// Clients API: MVP-53 (D-108). Soft-deleted only; national id and tax id are ciphertext (D-056).
model Client {
  id              String     @id @default(uuid(7)) @db.Uuid
  officeId        String     @map("office_id") @db.Uuid
  clientType      ClientType @map("client_type")
  displayName     String     @map("display_name")
  fullName        String?    @map("full_name")
  companyName     String?    @map("company_name")
  /// AES-256-GCM ciphertext `v<key>:…` (D-056, CHECK), never the raw number.
  nationalId      String?    @map("national_id")
  /// Ciphertext for an INDIVIDUAL client (D-056: tax ids of individuals; CHECK).
  taxId           String?    @map("tax_id")
  /// Keyed HMAC of the normalised identifier: matches a party to a client without decrypting (D-135).
  nationalIdIndex String?    @map("national_id_index")
  taxIdIndex      String?    @map("tax_id_index")
  phone           String?
  email           String?    @db.Citext
  address         String?
  industry        String?
  primaryLawyerId String?    @map("primary_lawyer_id") @db.Uuid
  isActive        Boolean    @default(true) @map("is_active")
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  office        Office          @relation(fields: [officeId], references: [id])
  primaryLawyer User?           @relation("ClientPrimaryLawyer", fields: [primaryLawyerId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  files         FileClient[]
  notes         FileNote[]
  contacts      ContactPerson[]

  @@unique([id, officeId])
  @@index([officeId, displayName])
  @@index([officeId, nationalIdIndex])
  @@index([officeId, taxIdIndex])
  // Trigram indexes for the `search` filter (ILIKE '%term%', D-059).
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_display_name_trgm_idx")
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_full_name_trgm_idx")
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_company_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_phone_trgm_idx")
  @@map("clients")
}

/// A contact person of a client (MVP-53). A client with contacts has exactly one primary (partial unique index + service).
model ContactPerson {
  id        String   @id @default(uuid(7)) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  fullName  String   @map("full_name")
  position  String?
  email     String?  @db.Citext
  phone     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])
  client Client @relation(fields: [clientId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)

  @@index([officeId, clientId])
  @@map("contact_persons")
}

/// A case. Open-file and list indexes are partial/covering SQL indexes in the migration.
model LegalFile {
  id                     String        @id @default(uuid(7)) @db.Uuid
  officeId               String        @map("office_id") @db.Uuid
  /// Rendered from OfficeSettings.fileNumberFormat by FileNumberService; never reused, also after a soft delete.
  fileNumber             String        @map("file_number")
  title                  String
  description            String?
  fileType               FileType      @map("file_type")
  subType                String?       @map("sub_type")
  status                 FileStatus    @default(OPEN)
  priority               Priority      @default(MEDIUM)
  openingDate            DateTime      @default(dbgenerated("CURRENT_DATE")) @map("opening_date") @db.Date
  closingDate            DateTime?     @map("closing_date") @db.Date
  responsibleLawyerId    String        @map("responsible_lawyer_id") @db.Uuid
  responsibleParalegalId String?       @map("responsible_paralegal_id") @db.Uuid
  courtCaseNumber        String?       @map("court_case_number")
  jurisdiction           Jurisdiction
  billingMethod          BillingMethod @default(HOURLY) @map("billing_method")
  hourlyRate             Decimal?      @map("hourly_rate") @db.Decimal(14, 2)
  fixedFee               Decimal?      @map("fixed_fee") @db.Decimal(14, 2)
  retainerBalance        Decimal       @default(0) @map("retainer_balance") @db.Decimal(14, 2)
  /// ISO-4217 code of every amount on the file (D-017).
  currency               String        @db.Char(3)
  isConfidential         Boolean       @default(false) @map("is_confidential")
  /// A platform court or one of the office's (D-037); a trigger checks it is visible to the file's office (D-115).
  courtId                String?       @map("court_id") @db.Uuid
  /// Requires `courtId` and sits at that court (same trigger).
  judgeId                String?       @map("judge_id") @db.Uuid
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  office               Office               @relation(fields: [officeId], references: [id])
  court                Court?               @relation(fields: [courtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  judge                Judge?               @relation(fields: [judgeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsibleLawyer    User                 @relation("FileResponsibleLawyer", fields: [responsibleLawyerId, officeId], references: [id, officeId], onUpdate: Restrict)
  responsibleParalegal User?                @relation("FileResponsibleParalegal", fields: [responsibleParalegalId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  clients              FileClient[]
  teamMembers          FileTeamMember[]
  parties              FileParty[]
  conflictsAsA         ConflictOfInterest[] @relation("ConflictFileA")
  conflictsAsB         ConflictOfInterest[] @relation("ConflictFileB")
  timeline             CaseTimelineEvent[]
  notes                FileNote[]
  tasks                Task[]
  sessions             Session[]
  documentFolders      DocumentFolder[]
  documents            Document[]

  @@unique([officeId, fileNumber])
  @@unique([id, officeId])
  // "Assigned" scope (D-051): responsible lawyer or paralegal; team members through file_team_members.
  @@index([officeId, responsibleLawyerId])
  @@index([officeId, responsibleParalegalId])
  // Foreign-key lookups when a court or judge is deleted (BIZ-011).
  @@index([courtId])
  @@index([judgeId])
  @@map("legal_files")
}

model FileClient {
  id        String   @id @default(uuid(7)) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// At most one per file: partial unique index in the migration.
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office    @relation(fields: [officeId], references: [id])
  file   LegalFile @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  client Client    @relation(fields: [clientId, officeId], references: [id, officeId], onUpdate: Restrict)

  @@unique([fileId, clientId])
  @@index([officeId, clientId])
  @@map("file_clients")
}

model FileTeamMember {
  id        String       @id @default(uuid(7)) @db.Uuid
  officeId  String       @map("office_id") @db.Uuid
  fileId    String       @map("file_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      FileTeamRole @default(MEMBER)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office    @relation(fields: [officeId], references: [id])
  file   LegalFile @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  user   User      @relation(fields: [userId, officeId], references: [id, officeId], onUpdate: Restrict)

  @@unique([fileId, userId])
  @@index([officeId, userId])
  @@map("file_team_members")
}

/// Gap-free counter per office, year and type code (D-095); `year` is 0 and `typeCode` '' when the format lacks them.
/// Incremented in the file's create transaction, so a rolled-back create gives its number back.
model FileNumberSequence {
  id        String   @id @default(uuid(7)) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  year      Int
  typeCode  String   @map("type_code")
  /// The last number issued.
  lastValue Int      @map("last_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, year, typeCode])
  @@map("file_number_sequences")
}

/// Office-scoped registry reused across files for conflict checks (D-030). Individual → fullName, else companyName (CHECK).
model Party {
  id                  String   @id @default(uuid(7)) @db.Uuid
  officeId            String   @map("office_id") @db.Uuid
  isIndividual        Boolean  @map("is_individual")
  fullName            String?  @map("full_name")
  companyName         String?  @map("company_name")
  /// AES-256-GCM ciphertext `v<key>:…` (D-056, CHECK).
  nationalId          String?  @map("national_id")
  /// Ciphertext when isIndividual (D-056: tax ids of individuals; CHECK).
  taxId               String?  @map("tax_id")
  /// Keyed HMAC of the normalised identifier for exact-match lookups without decrypting (D-135).
  nationalIdIndex     String?  @map("national_id_index")
  taxIdIndex          String?  @map("tax_id_index")
  address             String?
  phone               String?
  email               String?  @db.Citext
  legalRepresentative String?  @map("legal_representative")
  /// AES-256-GCM ciphertext `v<key>:…` (D-056, CHECK).
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office    Office                   @relation(fields: [officeId], references: [id])
  files     FileParty[]
  conflicts ConflictOfInterest[]
  sessions  SessionPartyAttendance[]

  @@unique([id, officeId])
  @@index([officeId, fullName])
  @@index([officeId, companyName])
  @@index([officeId, nationalIdIndex])
  @@index([officeId, taxIdIndex])
  @@map("parties")
}

model FileParty {
  id        String    @id @default(uuid(7)) @db.Uuid
  officeId  String    @map("office_id") @db.Uuid
  fileId    String    @map("file_id") @db.Uuid
  partyId   String    @map("party_id") @db.Uuid
  partyType PartyType @map("party_type")
  /// Free text shown next to the type, e.g. "Landlord".
  roleLabel String?   @map("role_label")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office    @relation(fields: [officeId], references: [id])
  file   LegalFile @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  party  Party     @relation(fields: [partyId, officeId], references: [id, officeId], onUpdate: Restrict)

  @@unique([fileId, partyId, partyType])
  // Conflict check: every file a party appears on.
  @@index([officeId, partyId])
  @@map("file_parties")
}

/// A party on file A in a role adverse to file B (domain-model invariant 6). file_id_a <> file_id_b (CHECK).
model ConflictOfInterest {
  id              String    @id @default(uuid(7)) @db.Uuid
  officeId        String    @map("office_id") @db.Uuid
  fileIdA         String    @map("file_id_a") @db.Uuid
  fileIdB         String    @map("file_id_b") @db.Uuid
  partyId         String    @map("party_id") @db.Uuid
  reason          String
  detectedAt      DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolved        Boolean   @default(false)
  resolutionNotes String?   @map("resolution_notes")
  resolvedById    String?   @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  office     Office    @relation(fields: [officeId], references: [id])
  fileA      LegalFile @relation("ConflictFileA", fields: [fileIdA, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  fileB      LegalFile @relation("ConflictFileB", fields: [fileIdB, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  party      Party     @relation(fields: [partyId, officeId], references: [id, officeId], onUpdate: Restrict)
  resolvedBy User?     @relation(fields: [resolvedById, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  /// Detection upserts on it, so re-running a check adds no duplicates.
  @@unique([fileIdA, fileIdB, partyId])
  @@index([officeId, resolved])
  @@index([officeId, partyId])
  @@index([officeId, fileIdA])
  @@index([officeId, fileIdB])
  @@map("conflicts_of_interest")
}

/// Append-only history of a file (no updatedAt).
model CaseTimelineEvent {
  id         String            @id @default(uuid(7)) @db.Uuid
  officeId   String            @map("office_id") @db.Uuid
  fileId     String            @map("file_id") @db.Uuid
  eventType  TimelineEventType @map("event_type")
  /// Entity behind the event (e.g. "Session") and its id; polymorphic, so no FK (D-015).
  sourceType String?           @map("source_type")
  sourceId   String?           @map("source_id") @db.Uuid
  occurredAt DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?           @map("actor_id") @db.Uuid
  /// i18n params for the client-side text.
  payload    Json              @default("{}")

  office Office    @relation(fields: [officeId], references: [id])
  file   LegalFile @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  actor  User?     @relation(fields: [actorId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, fileId, occurredAt(sort: Desc)])
  @@map("case_timeline_events")
}

/// A note on a file or a client (at least one of them, CHECK).
model FileNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  officeId       String   @map("office_id") @db.Uuid
  fileId         String?  @map("file_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  /// AES-256-GCM ciphertext `v<key>:…` when isConfidential (D-056, CHECK).
  body           String
  isConfidential Boolean  @default(false) @map("is_confidential")
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office     @relation(fields: [officeId], references: [id])
  file   LegalFile? @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  client Client?    @relation(fields: [clientId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  author User       @relation(fields: [authorId, officeId], references: [id, officeId], onUpdate: Restrict)

  @@index([officeId, fileId, createdAt(sort: Desc)])
  @@index([officeId, clientId, createdAt(sort: Desc)])
  @@map("file_notes")
}

// ─── Courts (D-037, D-115) ──────────────────────────────────────────────────────────────────────────────────────

/// Reference data: `officeId` null = a platform row (seeded, read-only to offices), set = the office's own row.
/// Platform rows are unique by (jurisdiction, nameEn) and office rows by (office, jurisdiction, nameAr): partial unique
/// indexes in the migration.
model Court {
  id           String       @id @default(uuid(7)) @db.Uuid
  officeId     String?      @map("office_id") @db.Uuid
  jurisdiction Jurisdiction
  courtType    CourtType    @map("court_type")
  nameAr       String       @map("name_ar")
  /// Required on platform rows (the seed key; CHECK).
  nameEn       String?      @map("name_en")
  city         String?
  address      String?
  phone        String?
  email        String?      @db.Citext
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict: SetNull would turn an office's rows into platform rows.
  office     Office?     @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  judges     Judge[]
  legalFiles LegalFile[]
  sessions   Session[]

  @@index([jurisdiction, officeId])
  @@index([officeId])
  @@map("courts")
}

/// Reference data like Court. A judge sits at a court visible to its office (trigger, D-115); the court never changes.
model Judge {
  id        String   @id @default(uuid(7)) @db.Uuid
  officeId  String?  @map("office_id") @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  fullName  String   @map("full_name")
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Restrict: SetNull would turn an office's rows into platform rows.
  office     Office?     @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  court      Court       @relation(fields: [courtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalFiles LegalFile[]
  sessions   Session[]

  @@index([courtId])
  @@index([officeId])
  @@map("judges")
}

model PublicProsecutor {
  id         String   @id @default(uuid(7)) @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  fullName   String   @map("full_name")
  /// The prosecution office (e.g. نيابة رام الله).
  officeName String?  @map("office_name")
  phone      String?
  email      String?  @db.Citext
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, fullName])
  @@map("public_prosecutors")
}

// ─── Hearings (D-036, D-116) ────────────────────────────────────────────────────────────────────────────────────

/**
 * A hearing (or mediation, arbitration session…) of a file. Times are UTC instants (`timestamptz`), shown in the
 * office's time zone. Status is derived: CANCELLED when `isCancelled`, COMPLETED once an outcome is recorded, else
 * SCHEDULED. CHECKs: ends after it starts, a cancelled session has no outcome, a session is not its own next one.
 * The court and judge are checked by a trigger like a file's (D-115).
 */
model Session {
  id                 String          @id @default(uuid(7)) @db.Uuid
  officeId           String          @map("office_id") @db.Uuid
  fileId             String          @map("file_id") @db.Uuid
  sessionType        SessionType     @default(HEARING) @map("session_type")
  startsAt           DateTime        @map("starts_at") @db.Timestamptz(3)
  /// Null = one hour for the conflict check (domain-model invariant 5).
  endsAt             DateTime?       @map("ends_at") @db.Timestamptz(3)
  courtId            String?         @map("court_id") @db.Uuid
  judgeId            String?         @map("judge_id") @db.Uuid
  courtRoom          String?         @map("court_room")
  attendingLawyerId  String          @map("attending_lawyer_id") @db.Uuid
  /// Days before the hearing a reminder is due (office default `courtReminderDays`).
  reminderDays       Int[]           @map("reminder_days")
  outcome            SessionOutcome?
  minutes            String?
  /// The session this one was adjourned to (set by POST /sessions/:id/outcome).
  nextSessionId      String?         @map("next_session_id") @db.Uuid
  isCancelled        Boolean         @default(false) @map("is_cancelled")
  cancellationReason String?         @map("cancellation_reason")
  createdById        String          @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  office          Office                   @relation(fields: [officeId], references: [id])
  file            LegalFile                @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  court           Court?                   @relation(fields: [courtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  judge           Judge?                   @relation(fields: [judgeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendingLawyer User                     @relation("SessionAttendingLawyer", fields: [attendingLawyerId, officeId], references: [id, officeId], onUpdate: Restrict)
  createdBy       User                     @relation("SessionCreator", fields: [createdById, officeId], references: [id, officeId], onUpdate: Restrict)
  nextSession     Session?                 @relation("SessionNext", fields: [nextSessionId, officeId], references: [id, officeId], onDelete: NoAction, onUpdate: Restrict)
  previousSession Session?                 @relation("SessionNext")
  reminders       SessionReminder[]
  attendances     SessionPartyAttendance[]
  documents       Document[]

  @@unique([id, officeId])
  /// Target of documents' (session_id, file_id, office_id) FK: a document's session belongs to the document's file.
  @@unique([id, fileId, officeId])
  // A session is adjourned to at most one next session, which follows at most one.
  @@unique([nextSessionId, officeId])
  // Conflict check (same attending lawyer, overlapping time) and the calendar filtered by lawyer.
  @@index([officeId, attendingLawyerId, startsAt])
  // Calendar of the whole office.
  @@index([officeId, startsAt])
  // A file's Sessions tab.
  @@index([officeId, fileId, startsAt])
  // Foreign-key lookups when a court or judge is deleted (BIZ-011).
  @@index([courtId])
  @@index([judgeId])
  @@map("sessions")
}

/**
 * One reminder of a session per `reminderDays` entry and recipient (D-036, D-117). Rescheduling cancels the PENDING rows
 * and adds new ones; cancelling the session cancels them. Each PENDING row is a delayed BullMQ job on the `reminder` queue
 * (`jobId`, null until enqueued); the daily reconciliation re-adds any that Redis lost.
 */
model SessionReminder {
  id             String         @id @default(uuid(7)) @db.Uuid
  officeId       String         @map("office_id") @db.Uuid
  sessionId      String         @map("session_id") @db.Uuid
  /// Who is reminded: the attending lawyer and the file's responsible lawyer get a row each (D-117).
  recipientId    String         @map("recipient_id") @db.Uuid
  daysBefore     Int            @map("days_before")
  scheduledFor   DateTime       @map("scheduled_for") @db.Timestamptz(3)
  status         ReminderStatus @default(PENDING)
  jobId          String?        @map("job_id")
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(3)
  acknowledgedAt DateTime?      @map("acknowledged_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  office    Office  @relation(fields: [officeId], references: [id])
  session   Session @relation(fields: [sessionId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  recipient User    @relation("SessionReminderRecipient", fields: [recipientId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, sessionId])
  @@index([officeId, recipientId])
  // The engine's sweep: due PENDING reminders.
  @@index([status, scheduledFor])
  @@map("session_reminders")
}

/**
 * Whether a party of the file attended a session (recorded with the minutes; API with the parties story).
 */
model SessionPartyAttendance {
  id            String   @id @default(uuid(7)) @db.Uuid
  officeId      String   @map("office_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  partyId       String   @map("party_id") @db.Uuid
  attended      Boolean?
  representedBy String?  @map("represented_by")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office  Office  @relation(fields: [officeId], references: [id])
  session Session @relation(fields: [sessionId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  party   Party   @relation(fields: [partyId, officeId], references: [id, officeId], onUpdate: Restrict)

  @@unique([sessionId, partyId])
  @@index([officeId, partyId])
  @@map("session_party_attendances")
}

// ─── Documents ──────────────────────────────────────────────────────────────────────────────────────────────────

/// A folder of one file's documents (D-119). System folders sit at the root, have a `systemKey` and no `name` (the UI
/// shows the label in the reader's language) and cannot be renamed, moved or deleted. CHECKs and the sibling-name
/// unique index are in migration add_documents.
model DocumentFolder {
  id        String           @id @default(uuid(7)) @db.Uuid
  officeId  String           @map("office_id") @db.Uuid
  fileId    String           @map("file_id") @db.Uuid
  /// Null = at the file's root. Always a folder of the same file (composite FK).
  parentId  String?          @map("parent_id") @db.Uuid
  name      String?
  systemKey FolderSystemKey? @map("system_key")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  office    Office           @relation(fields: [officeId], references: [id])
  file      LegalFile        @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  // NoAction (checked at the end of the statement) so purging a file can cascade through its whole tree.
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId, fileId, officeId], references: [id, fileId, officeId], onDelete: NoAction, onUpdate: Restrict)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  /// Target of the (folder_id, file_id, office_id) FKs: a subfolder or document is always in its folder's file.
  @@unique([id, fileId, officeId])
  @@unique([fileId, systemKey])
  @@index([officeId, fileId])
  @@map("document_folders")
}

/// A document of a file (D-035, D-119). Mirrors its current DocumentVersion (storage key, size, checksum, type).
model Document {
  id                  String            @id @default(uuid(7)) @db.Uuid
  officeId            String            @map("office_id") @db.Uuid
  fileId              String            @map("file_id") @db.Uuid
  /// Null = the file's root. A folder of the same file.
  folderId            String?           @map("folder_id") @db.Uuid
  /// The hearing the document belongs to, of the same file.
  sessionId           String?           @map("session_id") @db.Uuid
  /// Display name; the uploaded name (Arabic included) is kept as is in `originalFilename`.
  name                String
  originalFilename    String            @map("original_filename")
  documentType        DocumentType      @default(OTHER) @map("document_type")
  mimeType            String            @map("mime_type")
  sizeBytes           BigInt            @map("size_bytes")
  checksumSha256      String            @map("checksum_sha256") @db.Char(64)
  /// `{officeId}/{fileId}/{documentId}/{uuid}.{ext}` (D-035); never derived from the original name.
  storageKey          String            @unique @map("storage_key")
  currentVersion      Int               @default(1) @map("current_version")
  status              DocumentStatus    @default(UPLOADED)
  ocrStatus           OcrStatus         @default(PENDING) @map("ocr_status")
  /// Error code of a FAILED processing step (EXT-002 extraction; null for a failed scan) — D-132.
  processingErrorCode String?           @map("processing_error_code")
  language            DocumentLanguage?
  isConfidential      Boolean           @default(false) @map("is_confidential")
  sharedWithClient    Boolean           @default(false) @map("shared_with_client")
  /// The office user who uploaded it; portal uploads add `uploadedByClientUserId` with the Client Portal (D-119).
  uploadedById        String            @map("uploaded_by_id") @db.Uuid
  /// The client's `Idempotency-Key` of the upload that created it: a retry returns this document (D-126).
  idempotencyKey      String?           @map("idempotency_key")
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  office     Office            @relation(fields: [officeId], references: [id])
  file       LegalFile         @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  // NoAction (end of statement): purging a file cascades to its folders, sessions and documents together.
  folder     DocumentFolder?   @relation(fields: [folderId, fileId, officeId], references: [id, fileId, officeId], onDelete: NoAction, onUpdate: Restrict)
  session    Session?          @relation(fields: [sessionId, fileId, officeId], references: [id, fileId, officeId], onDelete: NoAction, onUpdate: Restrict)
  uploadedBy User              @relation("DocumentUploader", fields: [uploadedById, officeId], references: [id, officeId], onUpdate: Restrict)
  versions   DocumentVersion[]
  texts      DocumentText[]

  @@unique([id, officeId])
  // One upload per key and uploader (NULLs never collide).
  @@unique([officeId, uploadedById, idempotencyKey])
  // A file's documents, by folder (the Documents tab); also serves the folder FK checks (D-119).
  @@index([officeId, fileId, folderId])
  // Foreign-key lookup for a session (session documents).
  @@index([sessionId])
  @@map("documents")
}

/// Every stored upload of a document, the first one included (append-only: no `updatedAt`). Storage use of an office
/// is the sum of its versions' sizes (D-119).
model DocumentVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  officeId         String   @map("office_id") @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  storageKey       String   @unique @map("storage_key")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  sizeBytes        BigInt   @map("size_bytes")
  checksumSha256   String   @map("checksum_sha256") @db.Char(64)
  changeNote       String?  @map("change_note")
  createdById      String   @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  office    Office         @relation(fields: [officeId], references: [id])
  document  Document       @relation(fields: [documentId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  createdBy User           @relation("DocumentVersionCreator", fields: [createdById, officeId], references: [id, officeId], onUpdate: Restrict)
  texts     DocumentText[]

  @@unique([documentId, versionNumber])
  // Storage quota: an index-only sum per office.
  @@index([officeId, sizeBytes])
  @@map("document_versions")
}

/// Extracted (OCR or embedded) text of one document version, kept out of Document. The two search vectors are set by
/// a trigger (migration add_documents): `simple` over Arabic-normalised text and `english` with stemming (D-059).
model DocumentText {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  officeId            String                   @map("office_id") @db.Uuid
  documentId          String                   @map("document_id") @db.Uuid
  versionNumber       Int                      @map("version_number")
  text                String
  searchVectorSimple  Unsupported("tsvector")? @map("search_vector_simple")
  searchVectorEnglish Unsupported("tsvector")? @map("search_vector_english")
  pageCount           Int?                     @map("page_count")
  ocrEngine           String?                  @map("ocr_engine")
  /// 0–100.
  ocrConfidence       Decimal?                 @map("ocr_confidence") @db.Decimal(5, 2)
  /// What the OCR provider charged for this version, in USD (Google Vision, D-142); null for Tesseract and text layers.
  ocrCostUsd          Decimal?                 @map("ocr_cost_usd") @db.Decimal(10, 6)
  /// OCR only (D-139): mean word confidence (0–100) of each page in order, null for a page without words.
  pageConfidences     Json?                    @map("page_confidences")
  extractedAt         DateTime                 @default(now()) @map("extracted_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  office   Office          @relation(fields: [officeId], references: [id])
  document Document        @relation(fields: [documentId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  version  DocumentVersion @relation(fields: [documentId, versionNumber], references: [documentId, versionNumber], onDelete: Cascade, onUpdate: Restrict)

  @@unique([documentId, versionNumber])
  @@index([officeId])
  @@index([searchVectorSimple], map: "document_texts_search_simple_idx", type: Gin)
  @@index([searchVectorEnglish], map: "document_texts_search_english_idx", type: Gin)
  @@map("document_texts")
}

/// Tasks created when a file of `fileType` (or any type when null) is opened; applied by the Tasks epic.
model TaskTemplate {
  id                  String        @id @default(uuid(7)) @db.Uuid
  officeId            String        @map("office_id") @db.Uuid
  name                String
  fileType            FileType?     @map("file_type")
  defaultTitle        String        @map("default_title")
  defaultDescription  String?       @map("default_description")
  dueDaysAfterOpen    Int?          @map("due_days_after_open")
  /// Which file team member gets the task; null = the responsible lawyer.
  defaultAssigneeRole FileTeamRole? @map("default_assignee_role")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, fileType])
  @@map("task_templates")
}

/**
 * A to-do on a file, or a personal one (fileId null: only its creator and assignee see it). `completedAt` is set
 * exactly while DONE (CHECK). Hard-deleted (audited); recurrence, reminders and template/AI sources join with their
 * stories (D-098).
 */
model Task {
  id           String     @id @default(uuid(7)) @db.Uuid
  officeId     String     @map("office_id") @db.Uuid
  fileId       String?    @map("file_id") @db.Uuid
  title        String
  description  String?
  /// Calendar date (D-092): a deadline, shown as written in every time zone.
  dueDate      DateTime?  @map("due_date") @db.Date
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(TODO)
  assignedToId String     @map("assigned_to_id") @db.Uuid
  createdById  String     @map("created_by_id") @db.Uuid
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz(3)
  /// Position in its Kanban column, ascending (PATCH /tasks/reorder).
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  office     Office     @relation(fields: [officeId], references: [id])
  file       LegalFile? @relation(fields: [fileId, officeId], references: [id, officeId], onDelete: Cascade, onUpdate: Restrict)
  assignedTo User       @relation("TaskAssignee", fields: [assignedToId, officeId], references: [id, officeId], onUpdate: Restrict)
  createdBy  User       @relation("TaskCreator", fields: [createdById, officeId], references: [id, officeId], onUpdate: Restrict)

  // "My tasks" (assignee, status, due date) and a file's Tasks tab.
  @@index([officeId, assignedToId, status, dueDate])
  @@index([officeId, fileId])
  @@map("tasks")
}

// ─── Cross-cutting ──────────────────────────────────────────────────────────────────────────────────────────────

/// Append-only: the app role has no UPDATE/DELETE grant (revoked by the init migration and docs/runbooks/db-roles.sql). Retention purge runs as the
/// migrator. Secrets are redacted from old/new values before insert.
model AuditLog {
  id              String      @id @default(uuid(7)) @db.Uuid
  officeId        String      @map("office_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  platformAdminId String?     @map("platform_admin_id") @db.Uuid
  entityType      String      @map("entity_type")
  entityId        String?     @map("entity_id") @db.Uuid
  action          AuditAction
  oldValues       Json?       @map("old_values")
  newValues       Json?       @map("new_values")
  ipAddress       String?     @map("ip_address") @db.Inet
  userAgent       String?     @map("user_agent")
  /// Correlation id only (D-076), never evidence of identity.
  requestId       String?     @map("request_id")
  occurredAt      DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)

  office        Office         @relation(fields: [officeId], references: [id])
  // Restrict, not SetNull: FK actions run as the table owner, so SetNull/Cascade would let the app role rewrite the
  // append-only log by deleting or re-keying a user (users are deactivated, never deleted).
  user          User?          @relation(fields: [userId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)
  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, occurredAt(sort: Desc)])
  @@index([officeId, entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String              @id @default(uuid(7)) @db.Uuid
  officeId  String              @map("office_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      String
  /// i18n key; the UI renders it with `params`, never stored text.
  titleKey  String              @map("title_key")
  params    Json                @default("{}")
  link      String?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])
  user   User   @relation(fields: [userId, officeId], references: [id, officeId], onDelete: Cascade)

  // "My notifications, newest first"; unread counts filter on read_at within the same (office, user) range.
  @@index([officeId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// An asynchronous AI request (D-130): created QUEUED with its `ai` queue job, moved by the worker. Seen only by its
/// creator (`GET /jobs/:id`); `result` holds ids of what was produced, never the AI text itself.
model AiJob {
  id          String        @id @default(uuid(7)) @db.Uuid
  officeId    String        @map("office_id") @db.Uuid
  /// The `ai` queue job name, e.g. summarize-document.
  type        String
  sourceType  AiSourceType? @map("source_type")
  sourceId    String?       @map("source_id") @db.Uuid
  status      AiJobStatus   @default(QUEUED)
  /// Error code (AI-001…005, SYS-001) of a FAILED job; never a provider message.
  errorCode   String?       @map("error_code")
  attempts    Int           @default(0)
  result      Json?
  createdById String        @map("created_by_id") @db.Uuid
  startedAt   DateTime?     @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?     @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  office    Office @relation(fields: [officeId], references: [id])
  createdBy User   @relation(fields: [createdById, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, createdById, createdAt(sort: Desc)])
  @@map("ai_jobs")
}

/// One AI provider call (or cache hit) for cost tracking and the monthly quota (D-130, ai-ocr.md CostTracker).
/// Append-only: no updatedAt, UPDATE revoked from the app role.
model AiUsage {
  id             String   @id @default(uuid(7)) @db.Uuid
  officeId       String   @map("office_id") @db.Uuid
  /// Who asked; null for work the system started (auto-summary after OCR).
  userId         String?  @map("user_id") @db.Uuid
  feature        String
  provider       String
  model          String
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  costUsd        Decimal  @map("cost_usd") @db.Decimal(10, 6)
  durationMs     Int      @map("duration_ms")
  /// Served from the cache: no provider call, not counted against the quota.
  cached         Boolean  @default(false)
  /// How many values of each kind the PII redactor replaced, e.g. {"PARTY":3,"PHONE":1} (D-131) — counts, never values.
  redactionStats Json     @default("{}") @map("redaction_stats")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id])
  user   User?  @relation(fields: [userId, officeId], references: [id, officeId], onDelete: Restrict, onUpdate: Restrict)

  // Monthly quota: provider calls of the office since the start of the month.
  @@index([officeId, createdAt])
  @@map("ai_usages")
}
