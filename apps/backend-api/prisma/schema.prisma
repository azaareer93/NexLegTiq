  LITIGATION
  CRIMINAL
  CONTRACT_DRAFTING
  LEGAL_ADVISORY
  COMPLIANCE
  CONFLICT_RESOLUTION
  BUSINESS_SUPPORT
  NDA_REVIEW
  WILL_TRUST
  COMPANY_FORMATION
  RENTAL_AGREEMENT
  EMPLOYMENT_CONTRACT
}

enum FileStatus {
  OPEN
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// D-037. Labels: `enums.courtType.<VALUE>`.
enum CourtType {
  CIVIL
  CRIMINAL
  COMMERCIAL
  LABOR
  FAMILY
  ADMINISTRATIVE
  SHARIA
  MAGISTRATE
  FIRST_INSTANCE
  APPEAL
  CASSATION
  SUPREME
  ARBITRATION
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum SessionType {
  HEARING
  MEDIATION
  ARBITRATION
  PRE_TRIAL
  STATUS_CONFERENCE
  APPEAL_HEARING
  JUDGMENT_PRONOUNCEMENT
}

enum SessionOutcome {
  ADJOURNED
  DECIDED
  SETTLED
  DISMISSED
  POSTPONED
}

enum ReminderStatus {
