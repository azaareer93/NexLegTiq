{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(pnpm nx:*)",
      "Bash(npx nx:*)",
      "Bash(npx prisma:*)",
      "Bash(npx ruflo@latest memory:*)",
      "Bash(npx ruflo@latest hooks:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(git rev-parse *)",
      "Bash(node .claude/hooks/:*)",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__getTransitionsForJiraIssue",
      "mcp__atlassian__getJiraIssueRemoteIssueLinks",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__claude-flow__memory_search",
      "mcp__claude-flow__memory_retrieve",
      "mcp__claude-flow__memory_list",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__notion__notion-update-page",
      "mcp__notion__notion-create-pages",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Read(./.env*)",
      "Edit(./.env.example)"
    ],
    "deny": [
      "Edit(./.env)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "env": {
    "NEXLEGTIQ_JIRA_PROJECT": "MVP",
    "NEXLEGTIQ_JIRA_SITE": "nexlegtiq.atlassian.net"
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "agent-skills@addy-agent-skills": true
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "atlassian",
    "notion",
    "claude-flow"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}
